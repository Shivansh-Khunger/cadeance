# Secrets for infra/langfuse/docker-compose.yml (local dev only).
# Copy to infra/langfuse/.env (gitignored) and replace every <...> with the
# output of the command next to it. Docker Compose reads this file
# automatically because it sits next to the compose file.
# Don't double-quote values (https://github.com/langfuse/langfuse/issues/3398).

# --- Langfuse app secrets ---
NEXTAUTH_SECRET=<openssl rand -base64 32>
SALT=<openssl rand -base64 32>
# Must be exactly 64 hex characters.
ENCRYPTION_KEY=<openssl rand -hex 32>

# --- Backing services (hex keeps them URL-safe: Postgres goes into DATABASE_URL) ---
POSTGRES_PASSWORD=<openssl rand -hex 24>
CLICKHOUSE_PASSWORD=<openssl rand -hex 24>
REDIS_AUTH=<openssl rand -hex 24>
MINIO_ROOT_PASSWORD=<openssl rand -hex 24>

# --- Headless init: org, project, API keys and login created on first start ---
# Docs: https://langfuse.com/self-hosting/administration/headless-initialization
# Only applied when the resources don't exist yet. Changing them later does
# nothing until you reset the volumes (see README.md).
LANGFUSE_INIT_ORG_ID=cadence
LANGFUSE_INIT_ORG_NAME=Cadence
LANGFUSE_INIT_PROJECT_ID=cadence-local
LANGFUSE_INIT_PROJECT_NAME=cadence-local
# The project keys. Copy them into the root .env.local as LANGFUSE_PUBLIC_KEY /
# LANGFUSE_SECRET_KEY, with LANGFUSE_BASE_URL=http://localhost:3100.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=<echo pk-lf-$(uuidgen | tr A-Z a-z)>
LANGFUSE_INIT_PROJECT_SECRET_KEY=<echo sk-lf-$(uuidgen | tr A-Z a-z)>
LANGFUSE_INIT_USER_EMAIL=dev@cadence.local
LANGFUSE_INIT_USER_NAME=Cadence Dev
LANGFUSE_INIT_USER_PASSWORD=<openssl rand -hex 16>
