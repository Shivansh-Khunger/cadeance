# Local self-hosted LiveKit server (infra/livekit, Docker Compose).
# These match its dev key pair (`devkey: secret`); use real keys on any shared server.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Deepgram speech-to-text (Nova-3). https://console.deepgram.com
DEEPGRAM_API_KEY=
# OpenRouter gateway for the LLM (DeepSeek V4.1 Flash), via the OpenAI plugin's with_openrouter. https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Cartesia text-to-speech (Sonic-3). https://play.cartesia.ai/keys
CARTESIA_API_KEY=

# Hono backend that the agent's tools call into (appointment endpoints).
API_BASE_URL=http://localhost:4000

# Langfuse tracing (optional). Unset = telemetry is a no-op (tests, CI).
# Locally: the self-hosted Langfuse in infra/langfuse (keys from its headless init).
# Production: Langfuse Cloud keys, set by the hosting platform, not this file.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
