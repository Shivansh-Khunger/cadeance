# Root env template. Key names only; never commit values.
#
# Two root files, both gitignored:
#   .env.local  values for running locally. agent/.env.local, api/.env.local and
#               web/.env.local are symlinks to it, so every app reads this file.
#   .env        remote/prod values, kept for reference. No app directory links to
#               it, so local runs never see its keys.
# Production does not read either file: the hosting platform supplies the env
# (self-host-livekit ticket 05).
#
# Copy this file to .env.local and fill it in for local dev.

# API server (api/)
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Postgres. Today .env and .env.local hold the same URL, so local `bun run db:push`
# (api/) targets the same database as prod.
DATABASE_URL=

# LiveKit (api/ and agent/). Local: infra/livekit dev server, devkey/secret.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Model providers (agent/)
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Optional: the API the agent's tools call (default http://localhost:4000).
# API_BASE_URL=

# Web client (web/). Inlined into the browser bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Langfuse tracing (agent/). Unset = tracing is off.
# .env.local: the self-hosted Langfuse in infra/langfuse. .env: Langfuse Cloud (JP).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
