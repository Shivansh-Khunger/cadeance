# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Postgres connection string (Supabase, Neon, local, etc.)
DATABASE_URL=postgresql://user:pass@localhost:5432/mykare

# LiveKit: the self-hosted local dev server (infra/livekit, `docker compose -f
# infra/livekit/docker-compose.yml up -d`). devkey/secret is the public dev key
# pair from infra/livekit/livekit.yaml; production uses its own URL and keys.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Tracing (optional, src/telemetry.ts): request and DB spans to Langfuse over
# OTLP/HTTP, joined to the agent's call trace through `traceparent`. Locally,
# the self-hosted Langfuse in infra/langfuse (http://localhost:3100). Leave any
# of the three unset to turn tracing off. Restart the API after changing them.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
